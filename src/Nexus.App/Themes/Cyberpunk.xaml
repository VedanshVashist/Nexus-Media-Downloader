<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         CYBERPUNK — inky violet-black with neon magenta + cyan.
         ============================================================ -->
    <sys:String x:Key="Theme.Id">Cyberpunk</sys:String>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="Brush.Bg.Window" Color="#0A0713" />
    <SolidColorBrush x:Key="Brush.Bg.Sidebar" Color="#070510" />
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#120E22" />
    <SolidColorBrush x:Key="Brush.Bg.SurfaceAlt" Color="#1B1533" />
    <SolidColorBrush x:Key="Brush.Bg.Input" Color="#0E0A1C" />
    <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="#99050310" />

    <!-- Borders -->
    <SolidColorBrush x:Key="Brush.Border" Color="#2A2150" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#3D2F73" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F5EEFF" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#C3B6E8" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#8577B0" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- Accent -->
    <Color x:Key="Color.Accent">#F92AAD</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="#F92AAD" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#FF57C2" />
    <SolidColorBrush x:Key="Brush.Accent.Muted" Color="#33F92AAD" />
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F92AAD" />
        <GradientStop Offset="1" Color="#22D3EE" />
    </LinearGradientBrush>

    <!-- Status -->
    <SolidColorBrush x:Key="Brush.Success" Color="#37E6A6" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFC53D" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FF4D6D" />
    <SolidColorBrush x:Key="Brush.Info" Color="#22D3EE" />

    <!-- Progress -->
    <SolidColorBrush x:Key="Brush.Progress.Track" Color="#2A2150" />
    <SolidColorBrush x:Key="Brush.Progress.Fill" Color="#F92AAD" />
</ResourceDictionary>
