<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         MIDNIGHT — deep charcoal-blue with a calm blue accent.
         Every theme defines this exact set of semantic keys.
         ============================================================ -->
    <sys:String x:Key="Theme.Id">Midnight</sys:String>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="Brush.Bg.Window" Color="#0F1115" />
    <SolidColorBrush x:Key="Brush.Bg.Sidebar" Color="#0B0D11" />
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="#171A21" />
    <SolidColorBrush x:Key="Brush.Bg.SurfaceAlt" Color="#1F232C" />
    <SolidColorBrush x:Key="Brush.Bg.Input" Color="#12151B" />
    <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="#99000000" />

    <!-- Borders -->
    <SolidColorBrush x:Key="Brush.Border" Color="#262B36" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#363D4A" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F2F5FA" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B6C0CF" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7C8698" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- Accent -->
    <Color x:Key="Color.Accent">#4C8DFF</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="#4C8DFF" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#6BA1FF" />
    <SolidColorBrush x:Key="Brush.Accent.Muted" Color="#334C8DFF" />
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4C8DFF" />
        <GradientStop Offset="1" Color="#6E5BFF" />
    </LinearGradientBrush>

    <!-- Status -->
    <SolidColorBrush x:Key="Brush.Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F5B84B" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FF5C6C" />
    <SolidColorBrush x:Key="Brush.Info" Color="#58C4FF" />

    <!-- Progress -->
    <SolidColorBrush x:Key="Brush.Progress.Track" Color="#262B36" />
    <SolidColorBrush x:Key="Brush.Progress.Fill" Color="#4C8DFF" />
</ResourceDictionary>
