<UserControl x:Class="Nexus.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             d:DesignHeight="800" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <!-- Product header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="72" Height="72" CornerRadius="{StaticResource Radius.Lg}"
                        Background="{DynamicResource Brush.Accent.Gradient}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="34"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.OnAccent}" />
                </Border>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" Style="{StaticResource Text.Hero}" d:Text="Nexus" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Foreground="{DynamicResource Brush.Text.Secondary}">
                        <Run Text="Version" />
                        <Run Text="{Binding AppVersion, Mode=OneWay}" d:Text="1.0.0" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource Text.Subtitle}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,0,24"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="A modern desktop media downloader built on yt-dlp and FFmpeg. Analyze a link, pick a format and quality, then download video, audio, thumbnails, subtitles, and metadata — with a queue, history, and favorites." />

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Updates" Style="{StaticResource Text.Heading}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding CheckForUpdatesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Check for updates" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding UpdateStatus}"
                                   Visibility="{Binding UpdateStatus, Converter={StaticResource Conv.StringToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Dependency versions -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Components" Style="{StaticResource Text.Heading}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Dependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                <Setter Property="Text" Value="&#xE783;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Text="{Binding Version}" d:Text="2025.09.01" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Links -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Resources" Style="{StaticResource Text.Heading}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Link}" Command="{Binding OpenGitHubCommand}" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="GitHub" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Link}" Command="{Binding OpenDocumentationCommand}" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Documentation" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Link}" Command="{Binding ReportIssueCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE730;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Report an issue" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Text="Nexus is a downloader front-end. Please respect the terms of service of the sites you use and only download content you have the right to." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
