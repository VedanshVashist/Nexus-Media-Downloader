<UserControl x:Class="Nexus.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DownloadsViewModel}"
             d:DesignHeight="800" d:DesignWidth="900">

    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Downloads" Style="{StaticResource Text.Title}" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0">
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text="total ·" />
                    <Run Text="{Binding ActiveCount, Mode=OneWay}" />
                    <Run Text="active ·" />
                    <Run Text="{Binding CompletedCount, Mode=OneWay}" />
                    <Run Text="completed" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <Grid Grid.Column="0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,9,12,9" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14"
                           HorizontalAlignment="Left" Margin="12,0,0,0"
                           Foreground="{DynamicResource Brush.Text.Muted}" IsHitTestVisible="False" />
                <TextBlock Text="Search downloads" Margin="34,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource Conv.StringToVisInverse}}" />
            </Grid>

            <ComboBox Grid.Column="1" Margin="10,0,0,0" MinWidth="150"
                      ItemsSource="{Binding FilterChoices}"
                      DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding StatusFilter}" />

            <!-- Bulk actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Icon}" Command="{Binding PauseAllCommand}"
                        ToolTip="Pause all" Content="&#xE769;" Margin="0,0,4,0" />
                <Button Style="{StaticResource Button.Icon}" Command="{Binding ResumeAllCommand}"
                        ToolTip="Resume all" Content="&#xE768;" Margin="0,0,4,0" />
                <Button Style="{StaticResource Button.Icon}" Command="{Binding RetryFailedCommand}"
                        ToolTip="Retry failed" Content="&#xE72C;" Margin="0,0,4,0" />
                <Button Style="{StaticResource Button.Icon}" Command="{Binding CancelAllCommand}"
                        ToolTip="Cancel all" Content="&#xE711;" Margin="0,0,4,0" />
                <Button Style="{StaticResource Button.Icon}" Command="{Binding ClearFinishedCommand}"
                        ToolTip="Clear finished" Content="&#xE74D;" />
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="40" Margin="0,0,0,28"
                VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource Conv.BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="46"
                           Foreground="{DynamicResource Brush.Text.Muted}" />
                <TextBlock Text="No downloads yet" Style="{StaticResource Text.Heading}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="Analyze a link on the Home page to start downloading."
                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,28"
                      Visibility="{Binding HasItems, Converter={StaticResource Conv.BoolToVis}}">
            <ItemsControl ItemsSource="{Binding ItemsView}" ItemTemplate="{StaticResource Template.DownloadCard}" />
        </ScrollViewer>
    </Grid>
</UserControl>
