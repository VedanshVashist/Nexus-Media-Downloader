<UserControl x:Class="Nexus.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}"
             d:DesignHeight="900" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,32">
        <Grid MaxWidth="920" HorizontalAlignment="Stretch">
            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Download anything" Style="{StaticResource Text.Title}" />
                <TextBlock Text="Paste a link to a video, playlist, or track to get started."
                           Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />

                <!-- URL entry -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 ToolTip="Paste an http(s) link">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AnalyzeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}"
                                Margin="8,0,0,0" Width="42" Height="42"
                                Command="{Binding PasteCommand}"
                                ToolTip="Paste from clipboard"
                                Content="&#xE77F;" />

                        <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="88"
                                Command="{Binding ClearCommand}"
                                Content="Clear" />

                        <Button Grid.Column="3" Style="{StaticResource Button.Primary}"
                                Margin="8,0,0,0" MinWidth="120"
                                Command="{Binding AnalyzeCommand}">
                            <Grid>
                                <TextBlock Text="Analyze"
                                           Visibility="{Binding IsAnalyzing, Converter={StaticResource Conv.InverseBoolToVis}}" />
                                <TextBlock Text="Analyzing…"
                                           Visibility="{Binding IsAnalyzing, Converter={StaticResource Conv.BoolToVis}}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Busy indicator -->
                <ProgressBar IsIndeterminate="True" Margin="2,12,2,0"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource Conv.BoolToVis}}" />

                <!-- Analysis error -->
                <Border Margin="0,12,0,0" Padding="14,10"
                        Background="{DynamicResource Brush.Bg.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Error}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}"
                        Visibility="{Binding AnalysisError, Converter={StaticResource Conv.StringToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" FontSize="16"
                                   Foreground="{DynamicResource Brush.Error}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding AnalysisError}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <Border Margin="0,20,0,0" Padding="40" Style="{StaticResource Card}"
                        Visibility="{Binding HasResult, Converter={StaticResource Conv.InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="46"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="No link analyzed yet" Style="{StaticResource Text.Heading}"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="Your video details and download options will appear here."
                                   Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ================= Result ================= -->
                <StackPanel Margin="0,20,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource Conv.BoolToVis}}">

                    <!-- Video preview -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasVideo, Converter={StaticResource Conv.BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="248" Height="140"
                                    CornerRadius="{StaticResource Radius.Md}"
                                    Background="{DynamicResource Brush.Bg.Input}">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,248,140" RadiusX="10" RadiusY="10" />
                                </Border.Clip>
                                <Border>
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding Video.ThumbnailUrl, Converter={StaticResource Conv.PathToImageLarge}}" />
                                    </Border.Background>
                                </Border>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Video.Title}" Style="{StaticResource Text.Heading}"
                                           TextTrimming="CharacterEllipsis" MaxHeight="56" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Video.Uploader}" Style="{StaticResource Text.Subtitle}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding Video.Uploader, Converter={StaticResource Conv.StringToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Video.Duration, Converter={StaticResource Conv.Duration}}"
                                                       Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0"
                                            Visibility="{Binding Video.ViewCount, Converter={StaticResource Conv.NullToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B3;" FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0" />
                                            <TextBlock Style="{StaticResource Text.Caption}">
                                                <Run Text="{Binding Video.ViewCount, Converter={StaticResource Conv.CompactNumber}, Mode=OneWay}" />
                                                <Run Text=" views" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Playlist preview -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasPlaylist, Converter={StaticResource Conv.BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="20"
                                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Playlist.Title}" Style="{StaticResource Text.Heading}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Subtitle}">
                                <Run Text="{Binding Playlist.Uploader, Mode=OneWay}" />
                            </TextBlock>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Text.Caption}">
                                    <Run Text="{Binding Playlist.Count, Mode=OneWay}" />
                                    <Run Text=" items — all will be downloaded" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Options" Style="{StaticResource Text.Heading}" Margin="0,0,0,14" />

                            <!-- Type + quality + container -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Quality" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Format" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" />

                                <Border Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"
                                        Background="{DynamicResource Brush.Bg.Input}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Md}" Padding="4"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ToggleButton.Segment}" GroupName="dltype"
                                                     Content="Video"
                                                     IsChecked="{Binding SelectedDownloadType, Converter={StaticResource Conv.EnumToBool}, ConverterParameter=Video}" />
                                        <RadioButton Style="{StaticResource ToggleButton.Segment}" GroupName="dltype"
                                                     Content="Audio"
                                                     IsChecked="{Binding SelectedDownloadType, Converter={StaticResource Conv.EnumToBool}, ConverterParameter=Audio}" />
                                    </StackPanel>
                                </Border>

                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="12,6,0,0"
                                          ItemsSource="{Binding QualityChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedQuality}"
                                          IsEnabled="{Binding IsQualityAuto}" />

                                <ComboBox Grid.Row="1" Grid.Column="2" Margin="12,6,0,0"
                                          ItemsSource="{Binding ContainerChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedContainer}" />
                            </Grid>

                            <!-- Output directory -->
                            <TextBlock Text="Save to" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}"
                                        Content="Browse…" />
                            </Grid>

                            <!-- Exact format picker (video only) -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding HasVideo, Converter={StaticResource Conv.BoolToVis}}">
                                <Grid>
                                    <TextBlock Text="Or pick an exact format" Style="{StaticResource Text.Caption}"
                                               HorizontalAlignment="Left" />
                                    <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Right"
                                            Content="Use quality preset"
                                            Command="{Binding UseQualityPresetCommand}"
                                            Visibility="{Binding IsQualityAuto, Converter={StaticResource Conv.InverseBoolToVis}}" />
                                </Grid>
                                <ListBox Margin="0,6,0,0" MaxHeight="220"
                                         ItemsSource="{Binding Formats}"
                                         SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource Item.Selectable}" />
                            </StackPanel>

                            <!-- Content options -->
                            <TextBlock Text="Include" Style="{StaticResource Text.Caption}" Margin="0,18,0,8" />
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="Download thumbnail" IsChecked="{Binding DownloadThumbnail}" Margin="0,0,24,10" />
                                <CheckBox Content="Embed thumbnail" IsChecked="{Binding EmbedThumbnail}" Margin="0,0,24,10" />
                                <CheckBox Content="Embed metadata" IsChecked="{Binding EmbedMetadata}" Margin="0,0,24,10" />
                                <CheckBox Content="Embed chapters" IsChecked="{Binding EmbedChapters}" Margin="0,0,24,10" />
                                <CheckBox Content="Download subtitles" IsChecked="{Binding DownloadSubtitles}" Margin="0,0,24,10" />
                                <CheckBox Content="Auto-generated subtitles" IsChecked="{Binding DownloadAutomaticSubtitles}" Margin="0,0,24,10" />
                                <CheckBox Content="Embed subtitles" IsChecked="{Binding EmbedSubtitles}" Margin="0,0,24,10" />
                                <CheckBox Content="Save info .json" IsChecked="{Binding WriteInfoJson}" Margin="0,0,24,10" />
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding DownloadSubtitles, Converter={StaticResource Conv.BoolToVis}}">
                                <TextBlock Text="Subtitle languages" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Width="260" Text="{Binding SubtitleLanguages, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Comma-separated, e.g. en, es. Leave blank for all." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                        <Button Command="{Binding AddToFavoritesCommand}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Favorite" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddToQueueCommand}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Add to queue" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Primary}" MinWidth="150"
                                Command="{Binding DownloadCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Download" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
