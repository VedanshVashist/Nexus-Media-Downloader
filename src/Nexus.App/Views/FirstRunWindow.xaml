<Window x:Class="Nexus.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Nexus.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FirstRunViewModel}"
        Title="Welcome to Nexus"
        Width="760" Height="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Body}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.Bg.Window}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Wizard progress dot; accent-filled for the active step. -->
        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" />
        </Style>

        <!-- Row inside the dependency list. -->
        <Style x:Key="DepGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Text" Value="&#xE783;" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                    <Setter Property="Text" Value="&#xE73E;" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Bg.Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Brush.Accent.Gradient}">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE896;" FontSize="11"
                                   Foreground="{DynamicResource Brush.Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Nexus Setup" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <Button HorizontalAlignment="Right" Width="46" Height="44" Click="OnCloseClick" ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Brush.Text.Secondary}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="10" Text="&#xE8BB;"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Step content -->
            <Grid Grid.Row="1" Margin="48,8,48,0">

                <!-- Welcome -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsWelcome, Converter={StaticResource Conv.BoolToVis}}">
                    <Border Width="88" Height="88" CornerRadius="{StaticResource Radius.Lg}"
                            HorizontalAlignment="Center" Background="{DynamicResource Brush.Accent.Gradient}">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE896;" FontSize="42"
                                   Foreground="{DynamicResource Brush.Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Welcome to Nexus" Style="{StaticResource Text.Title}" Margin="0,24,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" FontWeight="Normal" Margin="0,10,0,0"
                               MaxWidth="480" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="A fast, modern desktop downloader for video, audio, and more. Let's get a couple of things set up before you start." />
                </StackPanel>

                <!-- Dependencies -->
                <StackPanel Visibility="{Binding IsDependencies, Converter={StaticResource Conv.BoolToVis}}">
                    <TextBlock Text="Required tools" Style="{StaticResource Text.Heading}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" FontWeight="Normal" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Nexus uses yt-dlp to fetch media and FFmpeg to convert and merge it. You can fetch yt-dlp now, or set custom paths later in Settings." />

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Dependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource DepGlyph}" FontSize="16"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock FontSize="{StaticResource Font.Caption}"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           Text="{Binding Detail}"
                                                           Visibility="{Binding Detail, Converter={StaticResource Conv.StringToVis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       FontSize="{StaticResource Font.Small}"
                                                       Text="{Binding Version}"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       Visibility="{Binding Version, Converter={StaticResource Conv.StringToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ProgressBar Minimum="0" Maximum="1" Height="6" Margin="0,14,0,0"
                                         Value="{Binding YtDlpProgress}"
                                         Visibility="{Binding IsDownloadingYtDlp, Converter={StaticResource Conv.BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding DownloadYtDlpCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Download yt-dlp" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0" Command="{Binding CheckDependenciesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Re-check" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Checking..." VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           Visibility="{Binding IsCheckingDependencies, Converter={StaticResource Conv.BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Preferences -->
                <StackPanel Visibility="{Binding IsPreferences, Converter={StaticResource Conv.BoolToVis}}">
                    <TextBlock Text="Make it yours" Style="{StaticResource Text.Heading}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" FontWeight="Normal" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Pick a theme and choose where your downloads are saved. You can change these anytime in Settings." />

                    <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,20,0,0" />
                    <ComboBox Margin="0,8,0,0" MaxWidth="320" HorizontalAlignment="Left"
                              ItemsSource="{Binding ThemeChoices}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedTheme}" />

                    <TextBlock Text="Download folder" FontWeight="SemiBold" Margin="0,20,0,0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DefaultDirectory}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Margin="10,0,0,0"
                                Command="{Binding BrowseDirectoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Browse" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Finish -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsFinish, Converter={StaticResource Conv.BoolToVis}}">
                    <Border Width="88" Height="88" CornerRadius="{StaticResource Radius.Lg}"
                            HorizontalAlignment="Center" Background="{DynamicResource Brush.Accent.Gradient}">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE930;" FontSize="42"
                                   Foreground="{DynamicResource Brush.Text.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="You're all set" Style="{StaticResource Text.Title}" Margin="0,24,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" FontWeight="Normal" Margin="0,10,0,0"
                               MaxWidth="480" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="Paste a link on the Home page to analyze it, then pick a format and download. Enjoy Nexus!" />
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="32,20,32,24">
                <!-- Step indicator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Welcome">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="Width" Value="34" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Dependencies">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="Width" Value="34" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Preferences">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="Width" Value="34" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Finish">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="Width" Value="34" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>

                <!-- Navigation buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding BackCommand}" Content="Back" />
                    <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0" Command="{Binding SkipCommand}"
                            Content="Skip setup"
                            Visibility="{Binding IsFinish, Converter={StaticResource Conv.InverseBoolToVis}}" />
                    <Button Style="{StaticResource Button.Primary}" Margin="10,0,0,0" MinWidth="120"
                            Command="{Binding NextCommand}" Content="{Binding NextLabel}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
