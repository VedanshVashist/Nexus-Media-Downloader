<UserControl x:Class="Nexus.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="900" d:DesignWidth="960">

    <UserControl.Resources>
        <!-- Local layout helpers, kept scoped to this page. -->
        <Style x:Key="L.Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style x:Key="L.Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
        <Style x:Key="L.Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="L.SectionHead" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource Text.Title}" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <!-- ============================ GENERAL ============================ -->
                <Border Style="{StaticResource L.Section}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource L.SectionHead}">
                            <TextBlock Text="General" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Startup and update behavior." Style="{StaticResource Text.Caption}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Launch Nexus automatically when you sign in."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimize to tray" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Keep running in the notification area when closed."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding MinimizeToTray}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Check for updates" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Look for new Nexus releases on startup."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding CheckForUpdates}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================ DOWNLOADS ============================ -->
                <Border Style="{StaticResource L.Section}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource L.SectionHead}">
                            <TextBlock Text="Downloads" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Where files land and how they are named." Style="{StaticResource Text.Caption}" />
                        </StackPanel>

                        <!-- Default directory -->
                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="Default download folder" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding DefaultDownloadDirectory}" />
                                <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                        Command="{Binding BrowseDefaultDirectoryCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Per-type directories -->
                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="Video folder" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding VideoDirectory}"
                                         d:Text="Uses default when empty" />
                                <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                        Command="{Binding BrowseVideoDirectoryCommand}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="Audio folder" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding AudioDirectory}" />
                                <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                        Command="{Binding BrowseAudioDirectoryCommand}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="Thumbnail folder" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ThumbnailDirectory}" />
                                <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                        Command="{Binding BrowseThumbnailDirectoryCommand}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="Subtitle folder" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SubtitleDirectory}" />
                                <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                        Command="{Binding BrowseSubtitleDirectoryCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Default format + quality -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Default container" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding ContainerChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding DefaultFormat}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Default quality" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding QualityChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding DefaultQuality}" />
                            </StackPanel>
                        </Grid>

                        <!-- Concurrency -->
                        <StackPanel Style="{StaticResource L.Field}">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Simultaneous downloads" Style="{StaticResource L.Label}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}"
                                           FontWeight="SemiBold" Text="{Binding MaxConcurrentDownloads}" />
                            </Grid>
                            <Slider Minimum="1" Maximum="{Binding MaxConcurrencyCeiling}"
                                    Value="{Binding MaxConcurrentDownloads}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" />
                        </StackPanel>

                        <!-- Auto start -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start downloads immediately" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Otherwise new items wait in the queue."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding AutoStartDownloads}" />
                        </Grid>

                        <!-- Retry -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Retry failed downloads" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Automatically try again after a failure."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding RetryFailedDownloads}" />
                        </Grid>
                        <StackPanel Style="{StaticResource L.Field}" IsEnabled="{Binding RetryFailedDownloads}">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Retry attempts" Style="{StaticResource L.Label}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}"
                                           FontWeight="SemiBold" Text="{Binding RetryCount}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="10" Value="{Binding RetryCount}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" />
                        </StackPanel>

                        <!-- Output template -->
                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="File naming template" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding OutputTemplate}" FontFamily="Consolas, monospace" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                       Text="Tokens: {title}, {id}, {ext}, {uploader}, {playlist}, {date}. Example: {title} [{id}].{ext}" />
                        </StackPanel>

                        <!-- Overwrite -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Overwrite existing files" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Off keeps both by adding a numeric suffix."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding OverwriteExisting}" />
                        </Grid>

                        <!-- Subfolders -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Organize into subfolders" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Group downloads by the options below."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding CreateSubfolders}" />
                        </Grid>
                        <StackPanel Margin="4,0,0,0" IsEnabled="{Binding CreateSubfolders}">
                            <CheckBox Content="By channel / uploader" IsChecked="{Binding SubfolderByChannel}" />
                            <CheckBox Content="By playlist" IsChecked="{Binding SubfolderByPlaylist}" Margin="0,6,0,0" />
                            <CheckBox Content="By date" IsChecked="{Binding SubfolderByDate}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ APPEARANCE ============================ -->
                <Border Style="{StaticResource L.Section}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource L.SectionHead}">
                            <TextBlock Text="Appearance" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Theme, accent, wallpaper, and window effects." Style="{StaticResource Text.Caption}" />
                        </StackPanel>

                        <!-- Theme + accent -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Theme" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding ThemeChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Theme}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Accent color" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" CornerRadius="{StaticResource Radius.Sm}"
                                            BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                                            Background="{Binding AccentColor, TargetNullValue={x:Null}}" />
                                    <TextBox Grid.Column="1" Margin="10,0,0,0" Text="{Binding AccentColor}"
                                             d:Text="#7C5CFF" FontFamily="Consolas, monospace" />
                                    <Button Grid.Column="2" Margin="10,0,0,0" Content="Default"
                                            Command="{Binding ClearAccentCommand}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                           Text="Leave blank to use the theme's own accent." />
                            </StackPanel>
                        </Grid>

                        <!-- Wallpaper enable -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Custom wallpaper" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Show a background image behind the app."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding WallpaperEnabled}" />
                        </Grid>

                        <!-- Wallpaper gallery -->
                        <StackPanel IsEnabled="{Binding WallpaperEnabled}">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Library" Style="{StaticResource L.Label}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Content="Import image…"
                                        Command="{Binding ImportWallpaperCommand}" />
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12"
                                       Text="No images imported yet. Use “Import image…” to add one."
                                       Visibility="{Binding Wallpapers.Count, Converter={StaticResource Conv.CountToVisInverse}}" />

                            <ItemsControl ItemsSource="{Binding Wallpapers}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="150" Height="90" Margin="0,0,10,10">
                                            <Border CornerRadius="{StaticResource Radius.Md}" BorderThickness="2"
                                                    ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource Conv.AreEqual}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.WallpaperFileName"
                                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Border Background="{DynamicResource Brush.Bg.SurfaceAlt}" />
                                                    <Border>
                                                        <Border.Background>
                                                            <ImageBrush Stretch="UniformToFill"
                                                                        ImageSource="{Binding Converter={StaticResource Conv.WallpaperImage}}" />
                                                        </Border.Background>
                                                    </Border>
                                                    <Button Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                            ToolTip="Remove"
                                                            Command="{Binding DataContext.RemoveWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Wallpaper display -->
                            <StackPanel Style="{StaticResource L.Field}" Margin="0,8,0,0">
                                <TextBlock Text="Fit" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding StretchChoices}" Width="200" HorizontalAlignment="Left"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding WallpaperStretch}" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource L.Field}">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Opacity" Style="{StaticResource L.Label}" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}"
                                               FontWeight="SemiBold" Text="{Binding WallpaperOpacity, StringFormat=P0}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" Value="{Binding WallpaperOpacity}" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource L.Field}">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Blur" Style="{StaticResource L.Label}" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}"
                                               FontWeight="SemiBold" Text="{Binding WallpaperBlur, StringFormat={}{0:F0}}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="40" Value="{Binding WallpaperBlur}" />
                            </StackPanel>

                            <StackPanel Style="{StaticResource L.Field}">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Darkening" Style="{StaticResource L.Label}" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Accent}"
                                               FontWeight="SemiBold" Text="{Binding WallpaperDarkness, StringFormat=P0}" />
                                </Grid>
                                <Slider Minimum="0" Maximum="1" Value="{Binding WallpaperDarkness}" />
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,4,0,16" Background="{DynamicResource Brush.Border}" />

                        <!-- Effects -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Animations" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Subtle transitions and motion." Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding AnimationEnabled}" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Transparency" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Frosted, translucent surfaces." Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding TransparencyEnabled}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Compact mode" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Tighter spacing for smaller screens." Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding CompactMode}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================ TOOLS ============================ -->
                <Border Style="{StaticResource L.Section}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource L.SectionHead}">
                            <TextBlock Text="Tools" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="yt-dlp and FFmpeg locations and status." Style="{StaticResource Text.Caption}" />
                        </StackPanel>

                        <!-- Dependency status -->
                        <ItemsControl ItemsSource="{Binding Dependencies}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Bg.SurfaceAlt}"
                                            CornerRadius="{StaticResource Radius.Sm}" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" FontSize="18"
                                                       VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                        <Setter Property="Text" Value="&#xE783;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Version}" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               Visibility="{Binding Version, Converter={StaticResource Conv.StringToVis}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Caption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Path, Converter={StaticResource Conv.StringToVis}}" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Warning}"
                                                           FontSize="{StaticResource Font.Caption}" TextWrapping="Wrap"
                                                           Visibility="{Binding Detail, Converter={StaticResource Conv.StringToVis}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="Ready" Foreground="{DynamicResource Brush.Success}"
                                                       Visibility="{Binding IsAvailable, Converter={StaticResource Conv.BoolToVis}}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="Missing" Foreground="{DynamicResource Brush.Warning}"
                                                       Visibility="{Binding IsAvailable, Converter={StaticResource Conv.InverseBoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button Content="Re-check" Command="{Binding CheckDependenciesCommand}" Margin="0,0,10,0" />
                            <Button Command="{Binding UpdateYtDlpCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Update yt-dlp" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ProgressBar Maximum="1" Value="{Binding YtDlpUpdateProgress}" Margin="0,-8,0,18"
                                     Visibility="{Binding IsUpdatingYtDlp, Converter={StaticResource Conv.BoolToVis}}" />

                        <!-- yt-dlp path -->
                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="yt-dlp executable" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding YtDlpPath}" d:Text="Bundled" />
                                <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                        Command="{Binding BrowseYtDlpCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                       Text="Leave blank to use the bundled copy." />
                        </StackPanel>

                        <!-- Custom args -->
                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="Extra yt-dlp arguments" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding YtDlpCustomArguments}" FontFamily="Consolas, monospace"
                                     AcceptsReturn="False" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                       Text="Advanced. Appended to every download; use with care." />
                        </StackPanel>

                        <!-- yt-dlp auto update -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Keep yt-dlp up to date" Style="{StaticResource L.Label}" />
                                <TextBlock Text="Check for a newer yt-dlp on startup."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding YtDlpAutoUpdate}" />
                        </Grid>

                        <!-- ffmpeg -->
                        <StackPanel Style="{StaticResource L.Field}">
                            <TextBlock Text="FFmpeg executable" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FfmpegPath}" d:Text="Bundled" />
                                <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                        Command="{Binding BrowseFfmpegCommand}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="FFprobe executable" Style="{StaticResource L.Label}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FfprobePath}" d:Text="Bundled" />
                                <Button Grid.Column="1" Content="Browse" Margin="10,0,0,0"
                                        Command="{Binding BrowseFfprobeCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ NOTIFICATIONS ============================ -->
                <Border Style="{StaticResource L.Section}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource L.SectionHead}">
                            <TextBlock Text="Notifications" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Choose which toasts you want to see." Style="{StaticResource Text.Caption}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="When a download starts" Style="{StaticResource L.Label}"
                                       VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding NotifyStarted}" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="When a download completes" Style="{StaticResource L.Label}"
                                       VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding NotifyCompleted}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="When a download fails" Style="{StaticResource L.Label}"
                                       VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" IsChecked="{Binding NotifyFailed}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Rectangle Height="8" Fill="Transparent" />
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky action bar -->
        <Border Grid.Row="2" Padding="0,14" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Border}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Revert" Command="{Binding ResetCommand}" Margin="0,0,10,0" MinWidth="110" />
                <Button Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" MinWidth="140">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Save changes" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
