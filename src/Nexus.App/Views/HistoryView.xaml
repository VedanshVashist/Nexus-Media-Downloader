<UserControl x:Class="Nexus.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
             d:DesignHeight="800" d:DesignWidth="900">

    <Grid Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="History" Style="{StaticResource Text.Title}" />

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,9,12,9" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14"
                           HorizontalAlignment="Left" Margin="12,0,0,0"
                           Foreground="{DynamicResource Brush.Text.Muted}" IsHitTestVisible="False" />
                <TextBlock Text="Search history" Margin="34,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource Conv.StringToVisInverse}}" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}" Content="Refresh" Margin="0,0,10,0" />
                <Button Style="{StaticResource Button.Danger}" Command="{Binding ClearCommand}" Content="Clear all" />
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Bottom" Margin="0,0,0,-8"
                     Visibility="{Binding IsBusy, Converter={StaticResource Conv.BoolToVis}}" />

        <!-- Empty state -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="40" Margin="0,0,0,28"
                VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource Conv.BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="46"
                           Foreground="{DynamicResource Brush.Text.Muted}" />
                <TextBlock Text="Nothing here yet" Style="{StaticResource Text.Heading}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="Completed and failed downloads are recorded here."
                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,28"
                      Visibility="{Binding HasItems, Converter={StaticResource Conv.BoolToVis}}">
            <ItemsControl ItemsSource="{Binding ItemsView}" />
        </ScrollViewer>
    </Grid>
</UserControl>
