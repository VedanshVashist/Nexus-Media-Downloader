<Window x:Class="Nexus.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Nexus.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}"
        Width="1240" Height="820" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource Font.Ui}" FontSize="{StaticResource Font.Body}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        Background="{DynamicResource Brush.Bg.Window}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Sidebar navigation entry: glyph + label with hover and active-item states. -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Radius.Md}"
                                Padding="14,10" Margin="12,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="navGlyph" FontFamily="{StaticResource Font.Icons}" FontSize="17"
                                           Width="24" TextAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding Glyph}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock x:Name="navLabel" Text="{Binding Title}" Margin="14,0,0,0"
                                           VerticalAlignment="Center" FontSize="{StaticResource Font.Body}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Bg.SurfaceAlt}" />
                                <Setter TargetName="navLabel" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource Conv.AreEqual}">
                                        <Binding Path="NavigationKey" />
                                        <Binding Path="DataContext.CurrentPage.NavigationKey"
                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent.Muted}" />
                                <Setter TargetName="navGlyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="navLabel" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="navLabel" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption (window control) button. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Bg.SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button: red hover per platform convention. -->
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- RootBorder paints the base window color; the wallpaper layer sits above it. -->
    <Border x:Name="RootBorder" Background="{DynamicResource Brush.Bg.Window}">
        <Grid>
            <!-- ===================== Wallpaper layer ===================== -->
            <Grid Visibility="{Binding WallpaperVisible, Converter={StaticResource Conv.BoolToVis}}">
                <Border Opacity="{Binding WallpaperOpacity}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding WallpaperPath, Converter={StaticResource Conv.PathToImageFull}}"
                                    Stretch="{Binding WallpaperStretch}" />
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="{Binding WallpaperBlur}" KernelType="Gaussian" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>
                <!-- Darkening scrim for text legibility over bright wallpapers. -->
                <Border Background="Black" Opacity="{Binding WallpaperDarkness}" />
            </Grid>

            <!-- ===================== Shell ===================== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom title bar (the whole row is the draggable caption). -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.Accent.Gradient}">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE896;" FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>

                    <!-- Active-downloads indicator -->
                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Padding="10,4"
                            CornerRadius="{StaticResource Radius.Pill}" Background="{DynamicResource Brush.Accent.Muted}"
                            Visibility="{Binding ActiveDownloadCount, Converter={StaticResource Conv.CountToVis}}"
                            ToolTip="Active downloads">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE896;" FontSize="11"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveDownloadCount}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Minimize">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="10" Text="&#xE921;" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick" ToolTip="Maximize">
                            <TextBlock x:Name="MaxRestoreGlyph" FontFamily="{StaticResource Font.Icons}" FontSize="10" Text="&#xE922;" />
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClick" ToolTip="Close">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="10" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Body: sidebar + page host -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Sidebar}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="236" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompactMode}" Value="True">
                                        <Setter Property="Width" Value="64" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <DockPanel Margin="0,8,0,10">
                            <!-- Secondary nav (Settings/About) pinned to the bottom. -->
                            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding SecondaryPages}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavItem}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border DockPanel.Dock="Bottom" Height="1" Margin="16,8"
                                    Background="{DynamicResource Brush.Border}" />

                            <!-- Primary nav fills the remaining space. -->
                            <ItemsControl ItemsSource="{Binding PrimaryPages}" Focusable="False" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavItem}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <!-- Page host: transparent so the wallpaper shows through card gaps. -->
                    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>
            </Grid>

            <!-- ===================== Toast overlay ===================== -->
            <ItemsControl ItemsSource="{Binding Toasts}" Focusable="False"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,20,20" Panel.ZIndex="50">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
