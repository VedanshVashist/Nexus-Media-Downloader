<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Nexus.App.Converters">

    <!-- Booleans / visibility -->
    <conv:BooleanToVisibilityConverter x:Key="Conv.BoolToVis" />
    <conv:InverseBooleanConverter x:Key="Conv.InverseBool" />
    <conv:InverseBooleanToVisibilityConverter x:Key="Conv.InverseBoolToVis" />
    <conv:StringToVisibilityConverter x:Key="Conv.StringToVis" />
    <conv:StringToVisibilityConverter x:Key="Conv.StringToVisInverse" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="Conv.NullToVis" />
    <conv:NullToVisibilityConverter x:Key="Conv.NullToVisInverse" Invert="True" />
    <conv:CountToVisibilityConverter x:Key="Conv.CountToVis" />
    <conv:CountToVisibilityConverter x:Key="Conv.CountToVisInverse" Invert="True" />

    <!-- Enum / equality -->
    <conv:EnumToBooleanConverter x:Key="Conv.EnumToBool" />
    <conv:EqualsConverter x:Key="Conv.Equals" />
    <conv:EqualityMultiConverter x:Key="Conv.AreEqual" />

    <!-- Formatting -->
    <conv:BytesToHumanConverter x:Key="Conv.Bytes" />
    <conv:SpeedToHumanConverter x:Key="Conv.Speed" />
    <conv:EtaToHumanConverter x:Key="Conv.Eta" />
    <conv:DurationConverter x:Key="Conv.Duration" />
    <conv:TimestampConverter x:Key="Conv.Timestamp" />
    <conv:LocalDateTimeConverter x:Key="Conv.LocalDateTime" />
    <conv:CompactNumberConverter x:Key="Conv.CompactNumber" />

    <!-- Images -->
    <conv:PathToImageSourceConverter x:Key="Conv.PathToImage" DecodeWidth="320" />
    <conv:PathToImageSourceConverter x:Key="Conv.PathToImageLarge" DecodeWidth="720" />
    <conv:PathToImageSourceConverter x:Key="Conv.PathToImageFull" DecodeWidth="0" />
    <conv:WallpaperImageConverter x:Key="Conv.WallpaperImage" DecodeWidth="360" />
    <conv:MultiplyConverter x:Key="Conv.Multiply" />

    <!-- Download status / type -->
    <conv:DownloadStatusToBrushConverter x:Key="Conv.StatusToBrush" />
    <conv:DownloadStatusToTextConverter x:Key="Conv.StatusToText" />
    <conv:DownloadStatusToGlyphConverter x:Key="Conv.StatusToGlyph" />
    <conv:DownloadTypeToGlyphConverter x:Key="Conv.TypeToGlyph" />
</ResourceDictionary>
