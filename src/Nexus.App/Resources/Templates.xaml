<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:vm="clr-namespace:Nexus.App.ViewModels"
                    xmlns:views="clr-namespace:Nexus.App.Views"
                    mc:Ignorable="d">

    <!-- ============================================================
         VIEW-MODEL  →  VIEW  (implicit, keyed by DataType)
         The shell's ContentControl binds to CurrentPage; WPF selects the
         matching view for the concrete page view-model at runtime.
         ============================================================ -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
        <views:DownloadsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:QueueViewModel}">
        <views:QueueView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <views:HistoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
        <views:FavoritesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <views:AboutView />
    </DataTemplate>

    <!-- ============================================================
         LIST ITEM CONTAINER STYLES
         ============================================================ -->

    <!-- Selectable row with hover + accent-selected states (format picker). -->
    <Style x:Key="Item.Selectable" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="{DynamicResource Brush.Bg.SurfaceAlt}"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent.Muted}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chrome-free container: the item's own template supplies all visuals (queue). -->
    <Style x:Key="Item.Plain" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         FORMAT OPTION  (format picker rows on Home)
         ============================================================ -->
    <DataTemplate DataType="{x:Type vm:FormatOptionViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding PrimaryLabel}" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding SecondaryLabel}" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="{DynamicResource Brush.Text.Muted}"
                       FontSize="{StaticResource Font.Small}" />
        </Grid>
    </DataTemplate>

    <!-- ============================================================
         TOAST NOTIFICATION
         ============================================================ -->
    <DataTemplate DataType="{x:Type vm:ToastViewModel}">
        <Border x:Name="toast" Width="340" Margin="0,10,0,0" Padding="0"
                Background="{DynamicResource Brush.Bg.Surface}"
                CornerRadius="{StaticResource Radius.Md}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Level accent bar -->
                <Border x:Name="bar" Grid.Column="0" Width="4" CornerRadius="6,0,0,6"
                        Background="{DynamicResource Brush.Info}" />

                <!-- Level icon -->
                <TextBlock x:Name="icon" Grid.Column="1" Style="{StaticResource Glyph}" FontSize="18"
                           Margin="14,0,0,0" VerticalAlignment="Center" Text="&#xE946;"
                           Foreground="{DynamicResource Brush.Info}" />

                <!-- Text -->
                <StackPanel Grid.Column="2" Margin="12,12,8,12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasTitle, Converter={StaticResource Conv.BoolToVis}}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <!-- Close -->
                <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Width="30" Height="30"
                        Margin="0,6,6,0" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip="Dismiss">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="11" />
                </Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Success">
                <Setter TargetName="bar" Property="Background" Value="{DynamicResource Brush.Success}" />
                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                <Setter TargetName="icon" Property="Text" Value="&#xE930;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warning">
                <Setter TargetName="bar" Property="Background" Value="{DynamicResource Brush.Warning}" />
                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                <Setter TargetName="icon" Property="Text" Value="&#xE7BA;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter TargetName="bar" Property="Background" Value="{DynamicResource Brush.Error}" />
                <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                <Setter TargetName="icon" Property="Text" Value="&#xE783;" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================
         HISTORY ROW
         ============================================================ -->
    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Thumbnail -->
                <Border Grid.Column="0" Width="120" Height="68" ClipToBounds="True"
                        CornerRadius="{StaticResource Radius.Sm}"
                        Background="{DynamicResource Brush.Bg.SurfaceAlt}">
                    <Grid>
                        <Border>
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Entry.ThumbnailUrl, Converter={StaticResource Conv.PathToImage}}" />
                            </Border.Background>
                        </Border>
                        <Border Background="#66000000" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                CornerRadius="4" Margin="4" Padding="4,1">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="11"
                                       Foreground="White"
                                       Text="{Binding Entry.DownloadType, Converter={StaticResource Conv.TypeToGlyph}}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Details -->
                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" d:Text="Sample video title" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{StaticResource Font.Small}"
                                   Text="{Binding Entry.DownloadedAt, Converter={StaticResource Conv.LocalDateTime}}" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{StaticResource Font.Small}"
                                   Text="{Binding Entry.Channel, StringFormat={}{0}, TargetNullValue=''}"
                                   Visibility="{Binding Entry.Channel, Converter={StaticResource Conv.StringToVis}}"
                                   Margin="8,0,0,0" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{StaticResource Font.Small}"
                                   Text="{Binding Entry.Quality}" Margin="8,0,0,0"
                                   Visibility="{Binding Entry.Quality, Converter={StaticResource Conv.StringToVis}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{Binding Entry.Status, Converter={StaticResource Conv.StatusToBrush}}"
                                   Text="{Binding Entry.Status, Converter={StaticResource Conv.StatusToGlyph}}" />
                        <TextBlock Margin="6,0,0,0" FontSize="{StaticResource Font.Small}" VerticalAlignment="Center"
                                   Foreground="{Binding Entry.Status, Converter={StaticResource Conv.StatusToBrush}}"
                                   Text="{Binding Entry.Status, Converter={StaticResource Conv.StatusToText}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenFileCommand}" ToolTip="Open file">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenFolderCommand}" ToolTip="Show in folder">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding RedownloadCommand}" ToolTip="Download again">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                    </Button>
                    <Button x:Name="favBtn" Style="{StaticResource Button.Icon}"
                            Command="{Binding ToggleFavoriteCommand}" ToolTip="Toggle favorite">
                        <TextBlock x:Name="favGlyph" Style="{StaticResource Glyph}" Text="&#xE734;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding CopyUrlCommand}" ToolTip="Copy link">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding DeleteCommand}" ToolTip="Remove from history">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                <Setter TargetName="favGlyph" Property="Text" Value="&#xE735;" />
                <Setter TargetName="favGlyph" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================
         FAVORITE ROW
         ============================================================ -->
    <DataTemplate DataType="{x:Type vm:FavoriteItemViewModel}">
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="120" Height="68" ClipToBounds="True"
                        CornerRadius="{StaticResource Radius.Sm}"
                        Background="{DynamicResource Brush.Bg.SurfaceAlt}">
                    <Border>
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding Entry.ThumbnailUrl, Converter={StaticResource Conv.PathToImage}}" />
                        </Border.Background>
                    </Border>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" d:Text="Favorite title" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{StaticResource Font.Small}"
                                   Text="{Binding Entry.Channel}"
                                   Visibility="{Binding Entry.Channel, Converter={StaticResource Conv.StringToVis}}" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{StaticResource Font.Small}"
                                   Text="{Binding Entry.AddedAt, Converter={StaticResource Conv.LocalDateTime}}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{StaticResource Font.Caption}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Entry.Url}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding DownloadCommand}" ToolTip="Download">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding AddToQueueCommand}" ToolTip="Add to queue">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenInBrowserCommand}" ToolTip="Open in browser">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding CopyUrlCommand}" ToolTip="Copy link">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding RemoveCommand}" ToolTip="Remove favorite">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================
         DOWNLOAD CARD  (Downloads page)  — keyed, DownloadItemViewModel
         ============================================================ -->
    <DataTemplate x:Key="Template.DownloadCard">
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Thumbnail -->
                <Border Grid.Column="0" Width="128" Height="72" ClipToBounds="True"
                        CornerRadius="{StaticResource Radius.Sm}"
                        Background="{DynamicResource Brush.Bg.SurfaceAlt}">
                    <Grid>
                        <Border>
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Model.ThumbnailUrl, Converter={StaticResource Conv.PathToImage}}" />
                            </Border.Background>
                        </Border>
                        <Border Background="#66000000" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                CornerRadius="4" Margin="4" Padding="4,1">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="11" Foreground="White"
                                       Text="{Binding Model.DownloadType, Converter={StaticResource Conv.TypeToGlyph}}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Details -->
                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Model.Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" d:Text="Downloading title" />

                    <!-- Status line -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{Binding Model.Status, Converter={StaticResource Conv.StatusToBrush}}"
                                   Text="{Binding Model.Status, Converter={StaticResource Conv.StatusToGlyph}}" />
                        <TextBlock Margin="6,0,0,0" FontSize="{StaticResource Font.Small}" VerticalAlignment="Center"
                                   Foreground="{Binding Model.Status, Converter={StaticResource Conv.StatusToBrush}}"
                                   Text="{Binding Model.Status, Converter={StaticResource Conv.StatusToText}}" />
                        <TextBlock Margin="8,0,0,0" FontSize="{StaticResource Font.Small}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Text="{Binding Model.Progress, StringFormat={}{0:0}%}"
                                   Visibility="{Binding Model.IsActive, Converter={StaticResource Conv.BoolToVis}}" />
                    </StackPanel>

                    <!-- Progress + stats (while active) -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding Model.IsActive, Converter={StaticResource Conv.BoolToVis}}">
                        <ProgressBar Value="{Binding Model.Progress, Mode=OneWay}" Maximum="100" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Brush.Text.Muted}"
                                       Text="{Binding Model.DownloadedBytes, Converter={StaticResource Conv.Bytes}}" />
                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Brush.Text.Muted}"
                                       Text="{Binding Model.TotalBytes, Converter={StaticResource Conv.Bytes}, StringFormat={} / {0}}"
                                       Visibility="{Binding Model.TotalBytes, Converter={StaticResource Conv.CountToVis}}" />
                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="12,0,0,0"
                                       Text="{Binding Model.Speed, Converter={StaticResource Conv.Speed}}" />
                            <TextBlock FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="12,0,0,0"
                                       Text="{Binding Model.Eta, Converter={StaticResource Conv.Eta}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Error (when failed) -->
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="{StaticResource Font.Caption}"
                               Foreground="{DynamicResource Brush.Error}" Text="{Binding Model.ErrorMessage}"
                               Visibility="{Binding Model.ErrorMessage, Converter={StaticResource Conv.StringToVis}}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding PauseCommand}" ToolTip="Pause"
                            Visibility="{Binding Model.IsActive, Converter={StaticResource Conv.BoolToVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding ResumeCommand}" ToolTip="Resume"
                            Visibility="{Binding Model.IsPaused, Converter={StaticResource Conv.BoolToVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenFileCommand}" ToolTip="Open file"
                            Visibility="{Binding Model.IsCompleted, Converter={StaticResource Conv.BoolToVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenFolderCommand}" ToolTip="Show in folder"
                            Visibility="{Binding Model.IsCompleted, Converter={StaticResource Conv.BoolToVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding RetryCommand}" ToolTip="Retry"
                            Visibility="{Binding Model.CanRetry, Converter={StaticResource Conv.BoolToVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding CancelCommand}" ToolTip="Cancel"
                            Visibility="{Binding Model.CanCancel, Converter={StaticResource Conv.BoolToVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding RemoveCommand}" ToolTip="Remove">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================
         QUEUE ROW  (Queue page)  — keyed, DownloadItemViewModel
         ============================================================ -->
    <DataTemplate x:Key="Template.QueueRow">
        <Border Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Reorder -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource Button.Icon}" Width="28" Height="24"
                            Command="{Binding MoveUpCommand}" ToolTip="Move up">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Width="28" Height="24"
                            Command="{Binding MoveDownCommand}" ToolTip="Move down">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- Thumbnail -->
                <Border Grid.Column="1" Width="96" Height="54" ClipToBounds="True"
                        CornerRadius="{StaticResource Radius.Sm}"
                        Background="{DynamicResource Brush.Bg.SurfaceAlt}">
                    <Grid>
                        <Border>
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Model.ThumbnailUrl, Converter={StaticResource Conv.PathToImage}}" />
                            </Border.Background>
                        </Border>
                        <Border Background="#66000000" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                CornerRadius="4" Margin="3" Padding="4,1">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="10" Foreground="White"
                                       Text="{Binding Model.DownloadType, Converter={StaticResource Conv.TypeToGlyph}}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="2" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Model.Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" d:Text="Queued title" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{StaticResource Font.Caption}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Model.Url}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding StartCommand}" Padding="12,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding RemoveFromQueueCommand}" ToolTip="Remove">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
